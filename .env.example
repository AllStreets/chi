# Vercel project environment variables (Project → Settings → Environment Variables).
# The frontend and API share one deployment, so both sets live here.

# ── API keys (server-side) ───────────────────────────────────────────────────
OPENWEATHER_API_KEY=
OPENWEATHER_KEY=
CTA_API_KEY=
TICKETMASTER_KEY=
CTA_BUS_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional extra data sources (routes fall back to free tiers without them)
FINNHUB_API_KEY=
FRED_API_KEY=
SEATGEEK_CLIENT_ID=

# ── Web push (optional; all three required to enable alerts) ─────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Any long random string. Required for /api/cron/* to run; without it those
# endpoints return 503 rather than being publicly triggerable.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Extra browser origin allowed through CORS. Same-origin requests from the
# deployed SPA need no configuration.
FRONTEND_URL=

# Override the SQLite location. Defaults to /tmp/chicago.db on Vercel and
# backend/chicago.db locally.
SQLITE_PATH=

# ── Build-time, exposed to the browser (must be set at build time) ───────────
VITE_MAPBOX_TOKEN=
# Leave unset so the SPA calls its own /api on the same origin. Only set this
# if the API is hosted somewhere else.
VITE_API_URL=
